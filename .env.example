# HireLens environment variables. Copy this file to .env.local and fill in your real keys there.
# This file is safe to share: it lists variable names only, no values.
# Never paste real keys into chat, code, docs or commits.
# SERVER ONLY: GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY and RESEND_API_KEY must only be used in server code.

# Google Gemini API key for AI CV screening and writing tools (server only)
GEMINI_API_KEY=

# Supabase project URL (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key, protected by Row Level Security (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service role) key, bypasses Row Level Security (server only)
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for sending emails (server only, only needed in Release 2)
RESEND_API_KEY=
